#!/bin/sh
# Mechanical checks only, so the hook works the same with or without an agent: src/ must build (the
# stylesheet compiles), docs/map.md's generated sections must match the code, and the Node files must
# parse. Enable: git config core.hooksPath .githooks
set -e
if ! git diff --quiet -- src docs/map.md server.js; then
  echo 'unstaged changes in src/, docs/map.md or server.js: stage them (or stash them) first'
  exit 1
fi
if [ ! -d node_modules/stylus ]; then
  echo 'the build needs its dependencies: run `npm install` once'
  exit 1
fi
node build.js
node scripts/harness-sync.js --check
node --check server.js
node --check dev/dummies.js
node --check build.js
