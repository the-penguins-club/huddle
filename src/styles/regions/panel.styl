// The panel: the controls (header), then the list box, which fills the rest and scrolls itself; on
// desktop the chat sits under them.
#panel
  position: relative
  z-index: 1
  width: 360px
  min-height: 0
  display: flex
  flex-direction: column
  border-left: 1px solid var(--line-strong)
  background: var(--bg)
#fold   // stacked layouts only
  display: none
#scroller   // the controls, then the list box, which fills the rest and scrolls itself
  flex: 1
  min-height: 0
  display: flex
  flex-direction: column
  overflow-y: auto
  background: var(--inset)
  > header   // on the same well as the list, so the list box is what stands out
    flex: none
    padding: 12px 16px 0
.h1row
  display: flex
  align-items: center
  gap: 8px
  margin-bottom: 10px
#theme   // Space | Time goes to the right
  margin-right: auto
#views   // desktop only; the stacked layouts have tabs
  display: none
.droprow
  display: flex
  gap: 6px
  > .btn.primary
    flex: 1
    min-width: 0
.tools
  display: flex
  flex-wrap: wrap
  gap: 6px
  margin-top: 8px
  > .btn
    flex: 1 1 auto
.droprow > .tools   // Time: its buttons share the first row with the link button
  flex: 1
  min-width: 0
  margin-top: 0
// each view shows its own buttons (.sp: Space, .tm: Time) and its own list
.tm
  display: none !important
body.view-time
  .tm:not([hidden])
    display: flex !important
  .sp
    display: none !important
#list
  .lbl
    font-weight: 600
  .mine
    cursor: text
    &:hover
      text-decoration: underline dotted
  li.latest .num
    background: var(--acc-grad)
    color: #fff
  li.owned .num
    background: var(--pc)
    color: #fff
