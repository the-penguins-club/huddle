// The room box: status, people, and the pick.
#room
  position: relative
  margin-top: 10px
  font-size: var(--fs-m)
.rowline
  display: flex
  align-items: center
  gap: 8px
  .grow
    flex: 1
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
.dot
  flex: none
  width: 8px
  height: 8px
  border-radius: 50%
  background: var(--mut)
  &.live
    background: var(--ok)
  &.reconnecting, &.connecting
    background: var(--warn)
  &.offline
    background: var(--acc)
#onlinebtn
  white-space: nowrap
// "N online ▾": the room's people, online first, then those who've been here
#members
  position: absolute
  z-index: 5
  top: calc(100% + 4px)
  left: 0
  right: 0
  max-height: 260px
  overflow-y: auto
  padding: 4px 0
#chatform #members   // opened from the chat: above its message box
  top: auto
  bottom: calc(100% + 4px)
  left: 8px
  right: 8px
// while it's open, the rest of its pane (the controls and lists, or the chat) is dimmed and out of reach;
// a click there closes it
#scroller, #chat
  position: relative
#scrim
  position: absolute
  inset: 0
  z-index: 4
  background: cmix(var(--bg), 60%, transparent)
  backdrop-filter: blur(1px)
#members
  h4
    margin: 6px 10px 2px
    color: var(--mut)
    font-size: var(--fs-xs)
    font-weight: 600
    text-transform: uppercase
    letter-spacing: .04em
  .m
    display: flex
    align-items: center
    gap: 8px
    padding: 4px 10px
    &.off
      opacity: .55
    &.can
      cursor: pointer
      &:hover
        background: var(--hover)
  .alone
    padding: 4px 10px
    color: var(--mut)
    font-size: var(--fs-s)
#roomhelp
  margin: 8px 0 0
  color: var(--acc)
  font-size: var(--fs-s)
  code
    font-size: var(--fs-xs)
#live
  margin: 8px 0 0
  color: var(--mut)
  font-size: var(--fs-s)
  &:empty
    display: none
