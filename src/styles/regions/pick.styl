// The pick, one layout at every size: a vote badge (★ over the count), the time over the place (the
// same size), and the calendar button. Anything too long ends in "…" (the whole text is its tooltip).
#pick
  margin-top: 8px
.pick
  --pick-fs: var(--fs-body)
  display: grid
  grid-template-columns: auto minmax(0, 1fr) auto
  grid-template-areas: "badge when ics" "badge where ics"
  align-items: center
  gap: 0 10px
  padding: 7px 8px
  border: 1px solid cmix(var(--ok), 35%, var(--line))
  border-radius: var(--r)
  background: cmix(var(--ok), 7%, var(--card))
.pick-head
  grid-area: badge
  align-self: stretch
  min-width: 38px
  display: flex
  flex-direction: column
  justify-content: center
  align-items: center
  padding: 2px 6px
  border-radius: var(--r-s)
  background: cmix(var(--ok), 16%, var(--card))
  color: var(--ok)
  font-size: var(--fs-m)
  font-weight: 700
  line-height: 1.2
  font-variant-numeric: tabular-nums
.pick-label   // for screen readers
  position: absolute
  width: 1px
  height: 1px
  overflow: hidden
  clip-path: inset(50%)
.pick-when, .pick-where
  min-width: 0
  overflow: hidden
  font-size: var(--pick-fs)
  line-height: 1.3
  text-overflow: ellipsis
  white-space: nowrap
.pick-when
  grid-area: when
  font-weight: 700
  font-variant-numeric: tabular-nums
.pick-where
  grid-area: where
  color: var(--mut)
  b
    color: var(--fg)
    font-weight: 600
.pick
  >
    .btn.icon
      grid-area: ics
      width: 38px
      height: 38px
      color: var(--ok)
      svg
        width: 20px
        height: 20px
@media (max-width: 600px)
  .pick
    --pick-fs: var(--fs-m)
