// Buttons. .btn: a secondary button; .primary: the main action (red); .icon: square, holding an icon;
// .round: the small round ones by the title; .sm: the small icon buttons on the pin card. A mode
// that's on ([aria-pressed]) or a limit that's set (.set) is tinted red.
.btn
  display: inline-flex
  align-items: center
  justify-content: center
  gap: 6px
  padding: 6px 10px
  border: 1px solid var(--line-strong)
  border-radius: var(--r)
  background: var(--surf)
  color: var(--fg)
  font-size: var(--fs-m)
  font-weight: 500
  text-decoration: none
  white-space: nowrap
  box-shadow: var(--sh-1)
  transition: background .12s, border-color .12s, box-shadow .12s, filter .12s
  &:where(:hover:not(:disabled))
    background: var(--hover)
    border-color: cmix(var(--mut), 35%, var(--line-strong))
    box-shadow: var(--sh-2)
  &:disabled
    opacity: .45
    cursor: default
    box-shadow: none
.btn:is([aria-pressed="true"], .set)
  border-color: cmix(var(--acc), 45%, var(--line-strong))
  background: cmix(var(--acc), 8%, var(--card))
  color: var(--acc)
  font-weight: 600
  box-shadow: var(--sh-in)
.btn.primary
  padding: 10px 14px
  border: 0
  background: var(--acc-grad)
  color: #fff
  font-weight: 600
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .16), 0 1px 2px rgba(0, 0, 0, .16), 0 2px 6px var(--acc-glow)
  &:hover:not(:disabled)
    background: var(--acc-grad)
    filter: brightness(1.07)
  &:active
    filter: brightness(.94)
.btn.icon
  flex: none
  width: 40px
  padding: 0
  svg
    width: 18px
    height: 18px
.btn.round
  flex: none
  width: 20px
  height: 20px
  padding: 0
  border-radius: 50%
  color: var(--mut)
  font-size: var(--fs-xs)
  font-weight: 700
  line-height: 1
  &:hover:not(:disabled)
    color: var(--fg)
  svg
    width: 12px
    height: 12px
.btn.sm
  width: 24px
  height: 22px
  padding: 0
  border-radius: var(--r-s)
  font-size: var(--fs-s)
  box-shadow: none
  svg
    width: 13px
    height: 13px
// a text link that does something
.link
  padding: 0
  border: 0
  background: none
  color: var(--mut)
  font-size: var(--fs-s)
  font-weight: 400
  text-decoration: underline
  text-transform: none
  letter-spacing: 0
  &:hover
    color: var(--fg)
