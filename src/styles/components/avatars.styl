// Avatars: a person's identicon in a ring of their colour (the pins draw their own, see the map).
.face
  position: relative
  flex: none
  width: 18px
  height: 18px
  overflow: hidden
  border: 2px solid
  border-radius: 50%
  background: #fff
  svg
    width: 20px
    height: 20px
.av svg   // centred, so any clipping is even
  position: absolute
  left: 50%
  top: 50%
  transform: translate(-50%, -50%)
